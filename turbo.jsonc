{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    // Package fixtures read this owner's public declarations, as typed lint does.
    "typecheck": {
      "dependsOn": ["build"],
    },
    // A reverted source tree may have a lower ceiling in its Git ancestry.
    // Always run the history check, including when lint/test can use a cache.
    "check:style-size": {
      "cache": false,
      "outputs": [],
    },
    "lint": {
      "dependsOn": ["$TURBO_EXTENDS$", "check:style-size"],
    },
    "test": {
      "dependsOn": ["$TURBO_EXTENDS$", "check:style-size"],
    },
  },
}
