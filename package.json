  "scripts": {
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css",
    "lint": "eslint src scripts test .ladle workbench vitest.config.ts --max-warnings=0 && ../../node_modules/.bin/oxlint --config ../../oxlint.config.ts --deny-warnings src scripts test .ladle workbench vitest.config.ts && pnpm lint:css && pnpm lint:motion && pnpm lint:theme",
    "lint:css": "stylelint 'src/**/*.css' '.ladle/**/*.css' 'workbench/**/*.css' --config stylelint.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && pnpm run build:css",
    "test": "vitest run --config vitest.config.ts && node --test scripts/fs-probe.test.mjs scripts/workbench-coverage.test.mjs scripts/workbench-process.test.mjs && pnpm test:design",
    "test:design": "node --test test/design-lint.test.mjs",
    "test:combobox": "node test/combobox.browser.mjs",
    "test:material-themes": "node test/material-themes.browser.mjs",
    "test:contrast": "node test/contrast.browser.mjs",
    "test:disabled-filled": "node test/disabled-filled.browser.mjs",
    "test:chat-bubble": "node test/chat-bubble.browser.mjs",
    "test:store-card": "node test/store-card.browser.mjs",
    "test:scroll-area": "node test/scroll-area-lifecycle.browser.mjs",
    "test:motion-visibility": "node test/motion-visibility.browser.mjs",
    "test:workbench-smoke": "node test/workbench-smoke.browser.mjs",
    "test:display-density": "node --import tsx ../../tooling/repository/scripts/workbench-proofs.mjs --output ../../.botanical/caps-workbench --origin-env CAPS_WORKBENCH_URL test/display-density.browser.mjs",
    "registry:generate": "node scripts/registry.mjs",
    "registry:check": "node scripts/registry.mjs check",
    "registry:stranger": "node scripts/registry-stranger.mjs",
    "workbench:serve": "node scripts/workbench-serve.mjs",
    "workbench:build": "node scripts/workbench-build.mjs",
    "workbench:contract": "node scripts/workbench-contract.mjs",
    "docs": "tsx ../../tooling/repository/src/docs/cli.ts check --root ../..",
    "docs:write": "tsx ../../tooling/repository/src/docs/cli.ts write --root ../..",
    "pack": "mkdir -p ../../.botanical/caps-pack && pnpm pack --pack-destination ../../.botanical/caps-pack",
    "smoke": "node --input-type=module -e \"Promise.all([import('./dist/lib/cn.js'), import('./dist/components/button.js'), import('./dist/blocks/mosaic.js'), import('./dist/blocks/app-bar.js')]).then(([lib, component, block, appBar]) => { if (typeof lib.cn !== 'function' || !component.Button || !block.Mosaic || !appBar.AppBar) process.exit(1); })\"",
    "stranger": "tsx ../../tooling/repository/src/artifacts/cli.ts --repo-root ../.. .",
    "format:check": "node ../../tooling/repository/scripts/format-package-check.mjs",
    "lint:anti-slop": "node ../../tooling/repository/scripts/lint-package-anti-slop.mjs",
    "build:workbench": "node scripts/workbench-build.mjs --prepared",
    "test:nightly": "node --import tsx ../../tooling/repository/scripts/workbench-proofs.mjs --output ../../.botanical/caps-workbench --origin-env CAPS_WORKBENCH_URL test/screen-theme.browser.mjs test/scroll-area.browser.mjs test/display-density.browser.mjs && node test/scroll-gutter.browser.mjs",
    "test:code-input": "node --import tsx ../../tooling/repository/scripts/workbench-proofs.mjs --output ../../.botanical/caps-code-input --origin-env CAPS_WORKBENCH_URL test/code-input.browser.mjs",
    "test:icon-choice": "node --import tsx ../../tooling/repository/scripts/workbench-proofs.mjs --output ../../.botanical/caps-icon-choice --origin-env CAPS_WORKBENCH_URL test/icon-choice.browser.mjs",
    "test:choice-label-alignment": "node --import tsx ../../tooling/repository/scripts/workbench-proofs.mjs --output ../../.botanical/caps-choice-alignment --origin-env CAPS_WORKBENCH_URL test/choice-label-alignment.browser.mjs",
    "lint:motion": "node --test scripts/motion-token-guard.test.mjs && node scripts/motion-token-guard.mjs",
    "test:card-theme": "node test/card-theme.browser.mjs",
    "test:window-theme": "node test/window-theme.browser.mjs",
    "test:game-theme": "node test/game-theme.browser.mjs",
    "lint:theme": "node --test scripts/theme-guard.test.mjs && node scripts/theme-guard.mjs",
    "test:app-bar-edge": "node --import tsx ../../tooling/repository/scripts/workbench-proofs.mjs --output ../../.botanical/caps-workbench --origin-env CAPS_WORKBENCH_URL test/app-bar-edge.browser.mjs",
    "test:overlay-layers": "node --import tsx ../../tooling/repository/scripts/workbench-proofs.mjs --output ../../.botanical/caps-workbench --origin-env CAPS_WORKBENCH_URL test/overlay-layers.browser.mjs"
  },
